<local:MyPageRight
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="d" x:Class="PageOtherExt"
    PanScroll="PanBack" RenderOptions.BitmapScalingMode="LowQuality">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,10" Grid.IsSharedSizeScope="True">
            <local:MyCard Margin="0,15" Title="拓展管理">
                <Grid Margin="21,40,21,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="35" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,12" TextWrapping="Wrap" LineHeight="19"
                               Text="拓展默认全部禁用。导入 .tmlext（Python / Node.js / C / Rust / Go）或 .jar（Java）扩展包后，需查看并确认其申请的权限，才会以独立子进程运行。扩展仅能使用经过审核的白名单能力，无法访问文件、网络、账号或启动器内部数据。" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <local:MyButton x:Name="BtnImport" Text="导入拓展" Width="160" Padding="13,0" Margin="0,0,15,0" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnRefresh" Text="刷新" Width="120" Padding="13,0" />
                    </StackPanel>
                </Grid>
            </local:MyCard>
            <StackPanel x:Name="PanExtList" />
            <local:MyCard Margin="0,0,0,15" Title="开发拓展">
                <StackPanel Margin="21,40,21,18">
                    <TextBlock Margin="0,0,0,14" TextWrapping="Wrap" LineHeight="19"
                               Text="拓展是独立子进程，只通过标准输入输出的 NDJSON 与启动器通信，任何能读写管道的语言都能写。下面六个仓库是官方模板：含 SDK、可运行的示例、打包脚本与 GitHub Actions 构建，克隆下来改一改就能用。协议文档见启动器仓库的 extensions/README.md。" />
                    <WrapPanel Orientation="Horizontal">
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="Python 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-python" />
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="Node.js 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-node" />
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="Java 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-java" />
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="C 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-c" />
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="Rust 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-rust" />
                        <local:MyButton Height="35" MinWidth="150" Margin="0,0,10,10" Padding="13,0" Text="Go 模板"
                                        local:CustomEventService.EventType="打开网页"
                                        local:CustomEventService.EventData="https://github.com/TYWStudio/template-tml-extension-go" />
                    </WrapPanel>
                    <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{DynamicResource ColorBrushGray4}"
                               Text="原生语言（C / Rust / Go）的扩展会被直接当作可执行文件拉起，不套解释器；Python 与 Node.js 需要本机已安装对应运行环境，启动器不会自动下载任何运行时。" />
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
