{
  "format": "tmlext",
  "apiVersion": 1,
  "id": "com.tyw.demo.hellorust",
  "name": "Hello Rust",
  "version": "1.0.0",
  "author": "TYWStudio",
  "description": "用 Rust 写的 TML 扩展示例：仅标准库，编译成原生可执行文件，由宿主以独立进程拉起",
  "runtime": "rust",
  "entry": "bin/tml_ext",
  "platforms": ["windows", "linux", "macos"],
  "permissions": ["log", "toast", "host.info", "instances.list", "events", "storage", "settings"],
  "subscribe": ["launcher.started", "game.launched", "settings.changed"]
}
